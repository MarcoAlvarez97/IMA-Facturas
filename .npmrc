# .npmrc — configuración para que npm permita ejecutar install scripts
# Crítico para Prisma: el postinstall baja los engine binaries que prisma generate necesita

# Permitir install scripts en dependencias (necesario para @prisma/engines)
allow-scripts=true

# Silenciar warnings molestos
fund=false
audit=false

# Para npm 11+ que tiene la nueva feature de "trusted scripts"
legacy-peer-deps=false
